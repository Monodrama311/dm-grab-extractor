# Copy to .env and fill in. .env is gitignored — never commit real values.

# Shared secret the extractor checks against the Worker's X-Internal-Token
# header. It MUST equal the dmlogic-web Worker secret EXTRACTOR_TOKEN
# (the current value was relayed to the owner separately; do not paste it here
# in any committed file).
INTERNAL_TOKEN=replace-with-the-64-hex-value-that-matches-the-worker-secret

# Optional: Netscape-format YouTube cookies. Leave blank — yt-dlp warns that
# an account used this way can be temporarily or permanently banned.
# YT_COOKIES=
